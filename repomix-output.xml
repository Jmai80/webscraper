  <input type="search" id="sok" placeholder="Sök på ingrediens, titel eller ord…" autocomplete="off">
  <p id="status"></p>
</header>
${kort}
<script>
  const falt = document.getElementById("sok");
  const status = document.getElementById("status");
  const kort = [...document.querySelectorAll(".recept")];

  falt.addEventListener("input", () => {
    const ord = falt.value.toLowerCase().split(/\\s+/).filter(Boolean);
    let synliga = 0;

    for (const el of kort) {
      const text = el.dataset.sok;
      const traff = ord.every((o) => text.includes(o));
      el.hidden = !traff;
      if (traff) synliga++;
    }

    status.textContent = ord.length === 0
      ? ""
      : \`\${synliga} av \${kort.length} recept\`;
  });
</script>
</body>
</html>`;
}
